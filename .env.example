# TrackR environment-variable reference.
# app.py does NOT automatically load .env files. Export these variables in your
# shell/IDE for local development, or configure them in Railway Variables.

# Required in production. Use a long random value (minimum 32 characters).
TRACKR_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Local development only. Do NOT set TRACKR_DB_PATH on Railway; when a Railway
# volume is mounted, TrackR always stores the live DB at <mount>/trackr.sqlite3.
TRACKR_DB_PATH=./flow.sqlite3
TRACKR_DEBUG=0
TRACKR_ENV=development
TRACKR_SECURE_COOKIES=0

# Used only when the selected database contains no login accounts.
TRACKR_BOOTSTRAP_ADMIN_USERNAME=admin
TRACKR_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-password-12-to-200-chars

# Optional first read-only/factory account. Leave both unset to skip creation.
# TRACKR_BOOTSTRAP_FACTORY_USERNAME=factory
# TRACKR_BOOTSTRAP_FACTORY_PASSWORD=replace-with-a-temporary-password-12-to-200-chars
